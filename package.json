{
  "name": "assisted-living-india",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean:appledouble": "node scripts/clean-appledouble.mjs",
    "predev": "pnpm clean:appledouble",
    "dev": "next dev",
    "prebuild": "pnpm clean:appledouble",
    "build": "next build",
    "postbuild": "pnpm clean:appledouble",
    "build:cloudflare": "pnpm build",
    "preview:cloudflare": "pnpm build:cloudflare && wrangler dev",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy",
    "upload:cloudflare": "pnpm deploy:cloudflare",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.130.0"
  },
  "packageManager": "pnpm@11.16.0"
}
